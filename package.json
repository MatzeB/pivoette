{
  "name": "pivoette",
  "version": "0.1.0",
  "description": "In-browser pivot-table / data-analysis component",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/pivoette.js",
  "module": "./dist/pivoette.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pivoette.js"
    },
    "./style.css": "./dist/pivoette.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:element": "vite build --config vite.element.config.ts",
    "build:demo": "vite build --config vite.element.config.ts && vite build --config vite.demo.config.ts",
    "build:pages": "vite build --config vite.element.config.ts && vite build --config vite.demo.config.ts && python3 demo/examples/regression/generate.py --stress && mkdir -p dist-demo/demo/examples/regression && cp demo/examples/regression/stress.json dist-demo/demo/examples/regression/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.7"
  }
}
